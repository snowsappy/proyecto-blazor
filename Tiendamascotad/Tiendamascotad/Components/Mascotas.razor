

<article class="tarjeta">
    <div class="contenido">
        <img src=@mascota.image />
    </div>
    <ul>
        <li>@mascota.birthdate</li>
        <li>@mascota.specie</li>
       
    </ul>
    <div class="texto">
        <h5>@mascota.name</h5>
        <p>@mascota.breed</p>
        <button class="boton" @onclick="info"><a href="/card/@mascota.id">Adopt</a> </button>

    </div>
   
   
</article>


@code{
    

    [Parameter]
    public Mascota mascota { get; set; }
    [Parameter]
    public EventCallback<Mascota> mascota_adoptada{ get; set; }

    public async Task info()
    {
        await mascota_adoptada.InvokeAsync(mascota);
    }
}