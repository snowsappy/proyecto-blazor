

<article class="tarjeta">
    <div class="contenido">
        <img src="@mascota.imagen" />
    </div>
    <ul>
        <li>@mascota.especie</li>
        <li>@mascota.nombre</li>
        <li>@mascota.edad years</li>
    </ul>
    <div class="texto">
        <h5>@mascota.nombre</h5>
        <button class="boton" @onclick="mascotasadoptadas">Adoptar</button>

    </div>
   
   
</article>


@code{

    [Parameter]
    public Mascota mascota { get; set; }
    [Parameter]
    public EventCallback<Mascota> mascota_adoptada{ get; set; }
      public async Task mascotasadoptadas()
      {
        await mascota_adoptada.InvokeAsync(mascota);
      }
      
}