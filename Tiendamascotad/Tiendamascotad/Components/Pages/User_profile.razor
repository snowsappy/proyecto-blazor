
@rendermode InteractiveServer
@inject Zozo_services zozo_services
@page "/adoptadas"
@inject Usuario_actual usuario_actual
<PageTitle>My contributions</PageTitle>


<div class="main">
    <div class="grupo-1">
        <div class="user-info">
            <div><img src="" alt="profile" /></div>
            <h3>welcome back! <br />@usuario_actual.firstname  @usuario_actual.lastname</h3>
            <p>Here you can manage your profile, check your adoption requests, and keep track of your favorite pets. </p>
        </div>
        <div class="adoptadas">
            <h1>My new friends</h1>
            @if (solicitudes == null)
            {
                <p>Loading...</p>
            }
            else if (solicitudes.Count == 0)
            {
                <p>You don't have any pets yet.</p>
            }
            else
            {
                <div class="fijar">
                    @foreach (var solicitud in solicitudes)
                    {
                        var mascota = mascotas.FirstOrDefault(m => m.id == solicitud.id_pet);

                        if (mascota != null)
                        {
                            <article class="perfil">

                                <div class="imagen">
                                    <img src="@mascota.image" alt="@mascota.name" />
                                </div>

                                <div class="texto">

                                    <p id="g">Thank you for helping us</p>

                                    <h3>Your friend name is: @mascota.name</h3>

                                    <div class="botones">

                                        <p>
                                            Is a beautiful @mascota.specie
                                            looking forward to stay with you.
                                        </p>

                                        <p>
                                            Breed: @mascota.breed
                                        </p>

                                        @if (solicitud.adoption_state == false)
                                        {
                                            <p>Adoption status: In process</p>
                                        }
                                        else
                                        {
                                            <p>Adoption status: Adopted</p>
                                        }

                                        <p>
                                            Request date: @solicitud.date_request
                                        </p>

                                    </div>

                                    <button>See info</button>

                                </div>

                            </article>
                        }
                    }
                </div>
            }
        </div>
        </div>
   <div class="grupo-2">
        <article class="directions">
            <p>direction:</p>
            <p><strong>@usuario_actual.adress</strong></p>
            <p>your pet is gonna get trough this route to yuor lovely home.</p>
        </article>
        <article class="contacto">
            <ul>
                <li><h6>phone</h6><p>@usuario_actual.phone</p></li>
                <li><h6>Email</h6><p>@usuario_actual.email</p></li>
            </ul>
        </article>
   </div>
</div>
