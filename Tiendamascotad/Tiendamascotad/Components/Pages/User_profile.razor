@code {
    
    //uso inject por que el new no me sirve
    private List<Solicitud>? solicitudes;
    private List<Mascota> mascotas = new();

    protected override async Task OnInitializedAsync()
    {
        solicitudes = await zozo_services.ObtenerSolicitudesUsuario(usuario_actual.id_user);

        foreach (var solicitud in solicitudes)
        {
            var mascota = await zozo_services.unamascota(solicitud.id_pet);

            if (mascota != null)
            {
                mascotas.Add(mascota);
            }
        }
    }
  

}
