@page "/contact us"
@rendermode InteractiveServer

<div class="formulario-contenedor">

    <h2>Contáctanos</h2>

    <EditForm Model="persona" OnValidSubmit="agregarpersona">

        <DataAnnotationsValidator />

        <div class="campo">
            <label>Nombre</label>
            <InputText @bind-Value="persona.Name" />
        </div>

        <div class="campo">
            <label>Número</label>
            <InputNumber @bind-Value="persona.numero" />
        </div>

        <div class="campo">
            <label>Gmail</label>
            <InputText @bind-Value="persona.gmail" />
            <ValidationMessage For="@(() => persona.gmail)" />
        </div>

        <div class="campo">
            <label>Mensaje</label>
            <InputTextArea @bind-Value="persona.mensaje" />
        </div>

        <button type="submit">Enviar</button>

    </EditForm>

</div>


@foreach (var item in lista)
{
    <div class="persona">
        <p><strong>Nombre:</strong> @item.Name</p>
        <p><strong>Gmail:</strong> @item.gmail</p>
        <p><strong>Número:</strong> @item.numero</p>
        <p><strong>Mensaje:</strong> @item.mensaje</p>
    </div>
}

@code
{
    Persona persona = new();

    List<Persona> lista = new List<Persona>();

    void agregarpersona()
    {
        lista.Add(persona);
        persona = new();
    }
}
}
