@page "/card/{id:int}"
@inject Mascota mascota
@inject Zozo_services zozo_services
<div class="body">
<div class="image">
    <img src="@mascota.image" alt="foto mascota" />
</div>
<div class=" info">
    <h5>@mascota.specie</h5>
    <h1>@mascota.name</h1>
    <p>@mascota.description</p>
    <div><p>@mascota.birthdate</p> <p>@mascota.breed</p></div>
    <button class="boton">Adopt now</button>
</div>
</div>

@code {
    [Parameter]
    public int id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        mascota = await zozo_services.unamascota(id);
    }


    
}
