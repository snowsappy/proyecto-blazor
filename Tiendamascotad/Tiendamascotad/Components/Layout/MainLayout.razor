@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="layout @(EsHome ? "home-layout" : "") @(EsAdoptadas ? "adoptadas-layout" : "")">

    <nav class="navegacion">

        <img src="/images/logo.png" alt="logo" />

        <ul>
            <li>
                <a href="/">our pets</a>
            </li>

            <li>
                about us
            </li>

            <li>
                <a href="/adoptadas">my contributions</a>
            </li>

            <li>
                <a href="/Contact us">contact us</a>
            </li>
        </ul>

    </nav>

    @Body

</div>


@code {

    private bool EsHome =>
        Navigation.ToBaseRelativePath(
            Navigation.Uri
        ).TrimEnd('/') == "";

    private bool EsAdoptadas =>
    Navigation.ToBaseRelativePath(Navigation.Uri)
    .TrimEnd('/') == "adoptadas";

}